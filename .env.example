# 项目全部配置的模板。复制一份为 .env，填入真实值即可；.env 已被 .gitignore 排除，不会提交。
# 优先级：系统环境变量 > .env > base/config.py 中的默认值。下面非密钥项的值即为默认值。

# ===================== 密钥与密码（必须自己填写） =====================
# 大模型密钥（阿里云百炼 DashScope）
DASHSCOPE_API_KEY=你的密钥
# Jev 路由密钥；通过 OpenRouter 调用时填 OpenRouter 密钥（sk-or- 开头）。留空时专业问题安全地进入完整 RAG。
JEV_API_KEY=你的Jev密钥
# MySQL 密码
MYSQL_PASSWORD=你的MySQL密码
# Redis 密码（无密码可留空）
REDIS_PASSWORD=

# ===================== MySQL =====================
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_DATABASE=subjects_kg

# ===================== Redis =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===================== Milvus =====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=itcast
MILVUS_COLLECTION_NAME=edurag_final

# ===================== 大模型 =====================
LLM_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===================== Jev 问题路由 =====================
# 通过 OpenRouter 调用；直连 TypeSafe 时改为 https://api.typesafe.ai/v1/systemone，模型名用 jev-latest。
JEV_ENDPOINT=https://openrouter.ai/api/v1/systemone
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=8
# 置信度低于该值时不信任 Jev 的判断，统一走完整 RAG。
JEV_CONFIDENCE_THRESHOLD=0.7

# ===================== 检索 =====================
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50
RETRIEVAL_K=3
CANDIDATE_M=2

# ===================== 热点问答与意图 =====================
# 阈值均为开发初始值，需要用标注数据校准。
HOT_QUESTION_BM25_THRESHOLD=0.85
HOT_QUESTION_REFRESH_SECONDS=60
INTENT_BM25_THRESHOLD=0.85
INTENT_INDEX_TTL_SECONDS=60

# ===================== FAQ =====================
FAQ_L2A_THRESHOLD=0.85
FAQ_L2A_MARGIN=0.05
FAQ_L2B_THRESHOLD=0.92
FAQ_L2B_MARGIN=0.05
FAQ_CACHE_TTL_SECONDS=3600

# ===================== 文档上传与摄取 =====================
DOCUMENT_UPLOAD_DIR=rag_qa/data/uploads
DOCUMENT_MAX_UPLOAD_BYTES=52428800
INGEST_MAX_CONCURRENT=2

# ===================== 应用 =====================
# 逗号分隔，也可写成 ["ai", "java"]。
VALID_SOURCES=ai,java,test,ops,bigdata
CUSTOMER_SERVICE_PHONE=12345678
LOG_FILE=logs/app.log
