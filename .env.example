# 环境变量示例文件 —— 提交到版本库的是本文件（不含真实值）
# 使用方式：复制一份为 .env，填入真实值即可（.env 已被 .gitignore 排除）
# 配置优先级：系统环境变量 > .env > config.ini > 代码默认值

# ---- 敏感配置：密钥与密码，必须配置 ----
# 大模型密钥（阿里云百炼 DashScope）
DASHSCOPE_API_KEY=你的密钥
# TypeSafe Jev 分类路由密钥；没有密钥时专业问题会安全地进入完整 RAG。
JEV_API_KEY=你的Jev密钥
# MySQL 密码
MYSQL_PASSWORD=你的MySQL密码
# Redis 密码（无密码可留空）
REDIS_PASSWORD=你的Redis密码

# ---- 以下为可选覆盖项，留空则使用 config.ini 中的值 ----
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_DATABASE=subjects_kg
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_DATABASE_NAME=itcast
# MILVUS_COLLECTION_NAME=edurag_final
# LLM_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
